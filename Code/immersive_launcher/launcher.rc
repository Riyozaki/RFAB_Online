#include "winres.h"
#include "BuildInfo.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,5,97,0
PRODUCTVERSION 1,5,97,0
FILEFLAGSMASK 0x17L
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x4L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bethesda Softworks"
            VALUE "ProductName", "The Elder Scrolls V: Skyrim Special Edition"
            VALUE "FileDescription", "Skyrim Special Edition (RFAB Online " BUILD_BRANCH "@" BUILD_COMMIT ")"
            VALUE "FileVersion", "1.5.97.0"
            VALUE "ProductVersion", "1.5.97.0"
            VALUE "OriginalFilename", "SkyrimSE.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "resources/launcher.manifest"

102 ICON "resources/st.ico"
